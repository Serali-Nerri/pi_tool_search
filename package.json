{
  "name": "pi-tool-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deferred tool discovery and activation for the pi coding agent.",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "verify": "npm run check && npm test",
    "deploy": "npm run verify && node scripts/deploy.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "~0.86.0",
    "@earendil-works/pi-tui": "~0.86.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-server": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@types/node": "^24.0.0",
    "pi-subagents-lite": "1.14.0",
    "tsx": "^4.23.12",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  }
}
